DUCKBRICKS_CATALOG_PATH=/data/metastore.ducklake
DUCKBRICKS_DATA_PATH=/data/parquet/
DUCKBRICKS_DUCKLAKE_NAME=duckbricks
DUCKBRICKS_HOST=0.0.0.0
DUCKBRICKS_PORT=8000
# Set to "development" to enable hot-reload
DUCKBRICKS_ENV=production
DATABASE_URL=postgresql://duckbricks:duckbricks@postgres:5432/duckbricks

# Path on the host / container where workspace files are stored
DUCKBRICKS_WORKSPACE_PATH=/data/workspace

# Secret key for encrypting stored credentials (Fernet base64-urlsafe 32-byte key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DUCKBRICKS_SECRET_KEY=
